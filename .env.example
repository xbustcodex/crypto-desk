# Paper equity (USD) used when no live balance reader is wired
INITIAL_EQUITY_USD=10000

# BTC cross-exchange spread that triggers desk halt (fraction, e.g. 0.003 = 0.3%)
MAX_BTC_SPREAD_PCT=0.003

# Risk limits (do not loosen in production without understanding consequences)
MAX_EQUITY_PCT=0.40
MAX_SLIPPAGE=0.02
HARD_STOP=-0.06

# Solana RPC (Helius / QuickNode / public)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional: EVM RPC for future rug checks
EVM_RPC_URL=

# Paper mode: true = no real orders
PAPER_MODE=true

# Decision log path
DECISION_LOG_PATH=decisions.jsonl
